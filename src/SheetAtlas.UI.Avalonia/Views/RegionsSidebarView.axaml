<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SheetAtlas.UI.Avalonia.ViewModels"
             xmlns:models="using:SheetAtlas.UI.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="600"
             x:Class="SheetAtlas.UI.Avalonia.Views.RegionsSidebarView"
             x:DataType="vm:RegionsSidebarViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="8,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Data Regions" FontWeight="SemiBold"
                      FontSize="14"
                      Foreground="{DynamicResource PrimaryText}"/>

            <Button Grid.Column="1" Content="Delete"
                    Classes="DangerButton"
                    Padding="8,4"
                    FontSize="11"
                    ToolTip.Tip="Delete selected region"
                    Command="{Binding DeleteRegionCommand}"
                    IsVisible="{Binding HasSelectedRegion}"/>
        </Grid>

        <!-- Region Tree -->
        <TreeView Grid.Row="1"
                  Margin="4"
                  Background="{DynamicResource CardBackground}"
                  BorderBrush="{DynamicResource BorderColor}"
                  BorderThickness="1"
                  CornerRadius="4"
                  ItemsSource="{Binding FileGroups}">

            <TreeView.DataTemplates>
                <!-- File Level -->
                <TreeDataTemplate DataType="models:FileRegionGroup"
                                  ItemsSource="{Binding Sheets}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding FileName}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"/>
                    </StackPanel>
                </TreeDataTemplate>

                <!-- Sheet Level -->
                <TreeDataTemplate DataType="models:SheetRegionGroup"
                                  ItemsSource="{Binding Regions}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SheetName}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </TreeDataTemplate>

                <!-- Region Level (leaf) -->
                <DataTemplate DataType="models:RegionItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryText}"/>
                            <TextBlock Text="{Binding BoundsText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="auto"
                                   FontSize="9"
                                   Foreground="{DynamicResource DisabledText}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsAutoDetected}"/>
                    </Grid>
                </DataTemplate>
            </TreeView.DataTemplates>
        </TreeView>

        <!-- Empty State -->
        <TextBlock Grid.Row="1"
                   Text="No data regions defined. Select a range on the grid canvas to create one."
                   TextWrapping="Wrap"
                   FontStyle="Italic"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="16"
                   IsVisible="{Binding !FileGroups.Count}"/>
    </Grid>
</UserControl>
