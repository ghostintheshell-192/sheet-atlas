<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SheetAtlas.UI.Avalonia.ViewModels"
             xmlns:models="using:SheetAtlas.UI.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="600"
             x:Class="SheetAtlas.UI.Avalonia.Views.RegionsSidebarView"
             x:DataType="vm:RegionsSidebarViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="8,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Data Regions" FontWeight="SemiBold"
                      FontSize="14"
                      Foreground="{DynamicResource PrimaryText}"/>

            <Button Grid.Column="1" Content="Apply to Files"
                    Padding="8,4"
                    FontSize="11"
                    Margin="0,0,4,0"
                    ToolTip.Tip="Detect and apply this region to other loaded files"
                    Command="{Binding DetectSimilarFilesCommand}"
                    IsVisible="{Binding HasSelectedRegion}"/>

            <Button Grid.Column="2" Content="Delete"
                    Classes="DangerButton"
                    Padding="8,4"
                    FontSize="11"
                    ToolTip.Tip="Delete selected region"
                    Command="{Binding DeleteRegionCommand}"
                    IsVisible="{Binding HasSelectedRegion}"/>
        </Grid>

        <!-- Region Tree -->
        <TreeView Grid.Row="1"
                  Margin="4"
                  Background="{DynamicResource CardBackground}"
                  BorderBrush="{DynamicResource BorderColor}"
                  BorderThickness="1"
                  CornerRadius="4"
                  ItemsSource="{Binding FileGroups}"
                  SelectionChanged="OnTreeViewSelectionChanged">

            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="models:FileRegionGroup">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
                <Style Selector="TreeViewItem" x:DataType="models:SheetRegionGroup">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.Styles>

            <TreeView.DataTemplates>
                <!-- File Level -->
                <TreeDataTemplate DataType="models:FileRegionGroup"
                                  ItemsSource="{Binding Sheets}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding FileName}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"/>
                    </StackPanel>
                </TreeDataTemplate>

                <!-- Sheet Level -->
                <TreeDataTemplate DataType="models:SheetRegionGroup"
                                  ItemsSource="{Binding Regions}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SheetName}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </TreeDataTemplate>

                <!-- Region Level (leaf) -->
                <DataTemplate DataType="models:RegionItem">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryText}"/>
                            <TextBlock Text="{Binding BoundsText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center" Margin="0,0,4,0">
                            <Border Background="{DynamicResource WarningBackground}"
                                    CornerRadius="10"
                                    Padding="4,2"
                                    IsVisible="{Binding HasWarnings}"
                                    ToolTip.Tip="{Binding WarningMessage}">
                                <TextBlock Text="⚠"
                                           FontSize="10"
                                           Foreground="{DynamicResource WarningColor}"/>
                            </Border>
                            <TextBlock Text="auto"
                                       FontSize="9"
                                       Foreground="{DynamicResource DisabledText}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsAutoDetected}"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="›"
                                FontSize="14"
                                FontWeight="Bold"
                                Padding="6,0"
                                MinWidth="0"
                                MinHeight="0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="View on canvas"
                                Command="{Binding DataContext.EditRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </TreeView.DataTemplates>
        </TreeView>

        <!-- Empty State -->
        <TextBlock Grid.Row="1"
                   Text="No data regions defined. Select a range on the grid canvas to create one."
                   TextWrapping="Wrap"
                   FontStyle="Italic"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="16"
                   IsVisible="{Binding !FileGroups.Count}"/>

        <!-- Detection Results Panel -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsDetectionActive}"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="4,4,4,4"
                Padding="8">
            <StackPanel Spacing="8">
                <!-- Panel Header -->
                <TextBlock Text="{Binding DetectionTitle}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource PrimaryText}"/>

                <!-- Results List -->
                <ItemsControl ItemsSource="{Binding DetectionResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:CrossFileApplyViewModel">
                            <Border Background="{DynamicResource SurfaceBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6"
                                    Margin="0,2">
                                <Grid ColumnDefinitions="Auto,*">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding IsMatch}"
                                              VerticalAlignment="Top"
                                              Margin="0,0,6,0"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource PrimaryText}"/>
                                        <!-- Match info with optional truncation warning -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    IsVisible="{Binding IsMatch}">
                                            <TextBlock Text="{Binding BoundsText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryText}"/>
                                            <Border Background="#FFF3CD"
                                                    CornerRadius="10"
                                                    Padding="4,2"
                                                    IsVisible="{Binding HasWarnings}"
                                                    ToolTip.Tip="{Binding WarningMessage}">
                                                <TextBlock Text="⚠"
                                                           FontSize="10"
                                                           Foreground="#856404"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- Warning for no match -->
                                        <TextBlock Text="{Binding WarningMessage}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   IsVisible="{Binding !IsMatch}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Apply Selected"
                            Padding="12,6"
                            FontSize="11"
                            Command="{Binding ApplyToSelectedFilesCommand}"/>
                    <Button Content="Cancel"
                            Padding="12,6"
                            FontSize="11"
                            Command="{Binding CancelDetectionCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
