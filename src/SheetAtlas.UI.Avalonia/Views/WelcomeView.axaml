<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SheetAtlas.UI.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="SheetAtlas.UI.Avalonia.Views.WelcomeView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600"
                    HorizontalAlignment="Left"
                    Margin="40,48,40,48"
                    Spacing="32">

            <!-- Title -->
            <StackPanel Spacing="8">
                <TextBlock Text="SheetAtlas"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="Compare and analyze Excel files — all data stays on your machine."
                           FontSize="14"
                           Foreground="{DynamicResource SecondaryText}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Getting started -->
            <StackPanel Spacing="12">
                <TextBlock Text="GET STARTED"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryText}"
                           LetterSpacing="1"/>

                <!-- Load files -->
                <Button Classes="HyperlinkButton"
                        Command="{Binding LoadFileCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Load Files"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource LinkText}"/>
                        <TextBlock Text="Load one or more Excel files to start"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Features (visible when files are loaded) -->
            <StackPanel Spacing="12"
                        IsVisible="{Binding HasLoadedFiles}">
                <TextBlock Text="FEATURES"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryText}"
                           LetterSpacing="1"/>

                <!-- Search -->
                <Button Classes="HyperlinkButton"
                        Command="{Binding ShowSearchTabCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Search"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource LinkText}"/>
                        <TextBlock Text="Search across all loaded files with regex support"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </Button>

                <!-- Data Regions -->
                <Button Classes="HyperlinkButton"
                        Command="{Binding ShowDataRegionsTabCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Data Regions"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource LinkText}"/>
                        <TextBlock Text="Define and detect structured data regions within sheets"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </Button>

                <!-- Templates -->
                <Button Classes="HyperlinkButton"
                        Command="{Binding ShowTemplatesTabCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Templates"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource LinkText}"/>
                        <TextBlock Text="Map and normalize columns across files using templates"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
