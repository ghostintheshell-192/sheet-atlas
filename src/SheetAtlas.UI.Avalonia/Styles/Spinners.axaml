<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Compact NumericUpDown: vertically stacked, equal-size chevron arrows -->
    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="ButtonSpinner">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="0"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}"/>
                        <Grid Grid.Column="1" RowDefinitions="*,*" Width="16">
                            <RepeatButton Name="PART_IncreaseButton"
                                          Grid.Row="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          Padding="0" MinWidth="0" MinHeight="0">
                                <Path Data="M 0,3 L 4,0 L 8,3"
                                      Stroke="{DynamicResource SecondaryText}"
                                      StrokeThickness="1.5"
                                      Width="8" Height="4"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </RepeatButton>
                            <RepeatButton Name="PART_DecreaseButton"
                                          Grid.Row="1"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          Padding="0" MinWidth="0" MinHeight="0">
                                <Path Data="M 0,0 L 4,3 L 8,0"
                                      Stroke="{DynamicResource SecondaryText}"
                                      StrokeThickness="1.5"
                                      Width="8" Height="4"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </RepeatButton>
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Hover: brighter arrows -->
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Disabled state: dimmed arrows -->
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:disabled Path">
        <Setter Property="Opacity" Value="0.3"/>
    </Style>

</Styles>
